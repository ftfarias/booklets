  (vn(6, "In petra exaltavit me, et nunc exaltavit caput meum super inimicos meos. Circuivi, et immolavi in tabernaculo ejus hostiam vociferationis; cantabo, et psalmum dicam Domino."), vn(6, "Ele me elevou sobre a pedra; e agora elevou ele a minha cabeça por cima dos meus inimigos. Eu andei ao redor, e eu imolei no seu tabernáculo uma vítima com clamores de júbilo: cantarei, e farei ressoar a melodia dos hinos para glória do Senhor.")),
  (vn(7, "Exaudi, Domine, vocem meam, qua clamavi ad te; miserere mei, et exaudi me."), vn(7, "Ouve, Senhor, a voz com que clamei a ti: tem compaixão de mim, e ouve-me.")),
  (vn(8, "Tibi dixit cor meum: Exquisivit te facies mea; faciem tuam, Domine, requiram."), vn(8, "O meu coração te disse: O meu rosto te buscou: eu buscarei, Senhor, o teu rosto.")),
  (vn(9, "Ne avertas faciem tuam a me; ne declines in ira a servo tuo. Adjutor meus esto; ne derelinquas me, neque despicias me, Deus salutaris meus."), vn(9, "Não apartes de mim a tua face, e não te retires do teu servo na tua ira. Sê minha ajuda: não me deixes, nem me desprezes, ó Deus, meu Salvador.")),
  (vn(10, "Quoniam pater meus et mater mea dereliquerunt me; Dominus autem assumpsit me."), vn(10, "Porque meu pai e minha mãe me deixaram; mas o Senhor me tomou na sua proteção.")),
  (vn(11, "Legem pone mihi, Domine, in via tua, et dirige me in semitam rectam, propter inimicos meos."), vn(11, "Prescreve-me, Senhor, a lei que devo seguir no teu caminho; e digna-te, por causa dos meus inimigos, de me conduzir pela vereda direita.")),
  (vn(12, "Ne tradideris me in animas tribulantium me, quoniam insurrexerunt in me testes iniqui, et mentita est iniquitas sibi."), vn(12, "Não me entregues à má vontade dos que me afligem: porque se levantaram contra mim testemunhas iníquas, e a iniquidade mentiu contra si mesma.")),
  (vn(13, "Credo videre bona Domini in terra viventium."), vn(13, "Eu creio que verei os bens do Senhor na terra dos vivos.")),
