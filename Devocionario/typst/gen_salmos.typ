#spread((
  (vn(1, "Dominus illuminatio mea et salus mea: quem timebo? Dominus protector vitae meae: a quo trepidabo?"), vn(1, "O Senhor é a minha luz e a minha salvação: que poderei eu temer? O Senhor é o defensor da minha vida: quem me poderá assustar?")),
  (vn(2, "Dum appropiant super me nocentes ut edant carnes meas, qui tribulant me inimici mei, ipsi infirmati sunt et ceciderunt."), vn(2, "Quando os que me querem perder estavam perto de investir comigo, para me comerem as carnes, então esses inimigos que me perseguem, esses mesmos foram enfraquecidos e caíram.")),
