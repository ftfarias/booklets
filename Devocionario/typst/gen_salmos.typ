#spread((
  (vn(2, "Quemadmodum desiderat cervus ad fontes aquarum, ita desiderat anima mea ad te, Deus."), vn(2, "Do modo que o cervo suspira pelas fontes das águas, assim a minha alma suspira por ti, ó Deus.")),
  (vn(3, "Sitivit anima mea ad Deum fortem, vivum; quando veniam, et apparebo ante faciem Dei?"), vn(3, "A minha alma está ardendo de sede por Deus, pelo Deus forte e vivo: quando virei eu, e quando aparecerei diante da face de Deus?")),
  (vn(4, "Fuerunt mihi lacrimae meae panes die ac nocte, dum dicitur mihi quotidie: Ubi est Deus tuus?"), vn(4, "As minhas lágrimas me serviram de pão de dia e de noite, quando se me diz todos os dias: Onde está o teu Deus?")),
  (vn(5, "Haec recordatus sum, et effudi in me animam meam, quoniam transibo in locum tabernaculi admirabilis, usque ad domum Dei, in voce exsultationis et confessionis, sonus epulantis."), vn(5, "Eu me lembrei destas coisas, e derramei a minha alma dentro de mim mesmo: porque eu passarei ao lugar do tabernáculo admirável, até a casa de Deus, entre cânticos de alegria e de louvor, e entre gritos de júbilo, como os daqueles que estão num banquete.")),
  (vn(6, "Quare tristis es, anima mea? et quare conturbas me? Spera in Deo, quoniam adhuc confitebor illi, salutare vultus mei,"), vn(6, "Por que estás tu triste, alma minha, e por que me turbas tu? Espera em Deus, porque eu ainda o louvarei, como quem é a salvação do meu rosto, e Deus meu.")),
  (vn(7, "et Deus meus. Ad meipsum anima mea conturbata est: propterea memor ero tui de terra Jordanis et Hermoniim a monte modico."), vn(7, "A minha alma toda se turbou em mim mesmo: por isso eu me lembrarei de ti, da terra do Jordão, de Hermon e do pequeno monte.")),
  (vn(8, "Abyssus abyssum invocat, in voce cataractarum tuarum; omnia excelsa tua, et fluctus tui super me transierunt."), vn(8, "Um abismo chama outro abismo ao ruído das tempestades e das águas que tu mandas. Todas as tuas águas levantadas como umas serras, e todas as tuas ondas passaram por cima de mim.")),
  (vn(9, "In die mandavit Dominus misericordiam suam, et nocte canticum ejus; apud me oratio Deo vitae meae."), vn(9, "De dia enviou o Senhor a sua misericórdia; e à noite é o meu cântico em ação de graças por ela. Eis aqui a oração que eu oferecerei no meu interior ao Deus da minha vida.")),
  (vn(10, "Dicam Deo: Susceptor meus es; quare oblitus es mei? et quare contristatus incedo, dum affligit me inimicus?"), vn(10, "Eu lhe direi: Tu és o meu defensor. Por que te esqueceste tu de mim? Por que ando eu oprimido de tristeza, enquanto o meu inimigo me aflige?")),
  (vn(11, "Dum confringuntur ossa mea, exprobraverunt mihi qui tribulant me inimici mei, dum dicunt mihi per singulos dies: Ubi est Deus tuus?"), vn(11, "Ao tempo que os meus ossos se quebram, me improperam os meus inimigos que me perseguem, dizendo-me todos os dias: Onde está o teu Deus?")),
  (vn(12, "Quare tristis es, anima mea? et quare conturbas me? Spera in Deo, quoniam adhuc confitebor illi, salutare vultus mei, et Deus meus."), vn(12, "Por que estás tu triste, alma minha, e por que me turbas tu? Espera no Senhor, porque eu ainda o louvarei, como quem é a salvação do meu rosto, e Deus meu.")),
