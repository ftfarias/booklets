#spread((
  (vn(3, "Miserere mei, Deus, secundum magnam misericordiam tuam; et secundum multitudinem miserationum tuarum, dele iniquitatem meam."), vn(3, "Tem compaixão de mim, ó Deus, segundo a tua grande misericórdia; e apaga a minha iniquidade, segundo a multidão das tuas comiserações.")),
  (vn(4, "Amplius lava me ab iniquitate mea, et a peccato meo munda me."), vn(4, "Lava-me cada vez mais da minha iniquidade, e purifica-me do meu pecado.")),
  (vn(5, "Quoniam iniquitatem meam ego cognosco, et peccatum meum contra me est semper."), vn(5, "Porque eu conheço a minha iniquidade, e tenho sempre o meu pecado diante dos olhos.")),
  (vn(6, "Tibi soli peccavi, et malum coram te feci; ut justificeris in sermonibus tuis, et vincas cum judicaris."), vn(6, "Eu pequei contra ti só, e fiz o mal na tua presença; para que tu sejas reconhecido justo nas tuas palavras, e saias vitorioso nos juízos que se farão de ti.")),
  (vn(7, "Ecce enim in iniquitatibus conceptus sum, et in peccatis concepit me mater mea."), vn(7, "Porque tu vês que eu fui gerado na iniquidade, e que minha mãe me concebeu no pecado.")),
  (vn(8, "Ecce enim veritatem dilexisti; incerta et occulta sapientiae tuae manifestasti mihi."), vn(8, "Porque tu amaste a verdade: tu me descobriste os segredos e os mistérios da tua sabedoria.")),
  (vn(9, "Asperges me hyssopo, et mundabor; lavabis me, et super nivem dealbabor."), vn(9, "Tu me borrifarás com o hissopo, e eu serei purificado; tu me lavarás, e eu me tornarei mais alvo do que a neve.")),
  (vn(10, "Auditui meo dabis gaudium et laetitiam, et exsultabunt ossa humiliata."), vn(10, "Tu me farás ouvir uma palavra de consolação e de alegria; e os meus ossos humilhados saltarão de gosto.")),
  (vn(11, "Averte faciem tuam a peccatis meis, et omnes iniquitates meas dele."), vn(11, "Aparta a tua face dos meus pecados, e apaga todas as minhas iniquidades.")),
  (vn(12, "Cor mundum crea in me, Deus, et spiritum rectum innova in visceribus meis."), vn(12, "Cria em mim, ó Deus, um coração puro; e restabelece de novo um espírito reto nas minhas entranhas.")),
  (vn(13, "Ne projicias me a facie tua, et spiritum sanctum tuum ne auferas a me."), vn(13, "Não me lances de diante da tua face, e não retires de mim o teu Santo Espírito.")),
  (vn(14, "Redde mihi laetitiam salutaris tui, et spiritu principali confirma me."), vn(14, "Restitui-me a alegria da tua saudável assistência, e fortifica-me com um espírito principal.")),
  (vn(15, "Docebo iniquos vias tuas, et impii ad te convertentur."), vn(15, "Eu ensinarei aos iníquos os teus caminhos, e os ímpios se converterão a ti.")),
  (vn(16, "Libera me de sanguinibus, Deus, Deus salutis meae, et exsultabit lingua mea justitiam tuam."), vn(16, "Livra-me dos sangues, ó Deus, ó Deus da minha salvação; e a minha língua engrandecerá a tua justiça em cânticos de júbilo.")),
  (vn(17, "Domine, labia mea aperies, et os meum annuntiabit laudem tuam."), vn(17, "Senhor, tu abrirás os meus lábios, e a minha boca anunciará os teus louvores.")),
  (vn(18, "Quoniam si voluisses sacrificium, dedissem utique; holocaustis non delectaberis."), vn(18, "Porque, se tu tiveras desejado um sacrifício, eu não teria faltado a to oferecer; mas tu não terás por agradáveis os holocaustos.")),
  (vn(19, "Sacrificium Deo spiritus contribulatus; cor contritum et humiliatum, Deus, non despicies."), vn(19, "O sacrifício digno de se oferecer a Deus é um espírito traspassado de dor: tu, ó Deus, não desprezarás a um coração contrito e humilhado.")),
  (vn(20, "Benigne fac, Domine, in bona voluntate tua Sion, ut aedificentur muri Jerusalem."), vn(20, "Senhor, trata benignamente a Sião, e faze-a sentir os efeitos da tua bondade, para que se edifiquem os muros de Jerusalém.")),
  (vn(21, "Tunc acceptabis sacrificium justitiae, oblationes et holocausta; tunc imponent super altare tuum vitulos."), vn(21, "Então é que tu receberás com agrado o sacrifício de justiça, as oblações e os holocaustos; então é que se te oferecerão os novilhos sobre o teu altar.")),
), toc: ((2, [50 (51) #h(0.4em) _Miserere mei, Deus_]),), head: (pshead("Psalmus L (51)", "In finem. Psalmus David, cum venit ad eum Nathan propheta, quando intravit ad Bethsabee."), pshead("Salmo 50 (51)", "Para o fim. Salmo de David, quando o profeta Natã veio ter com ele, por ter pecado com Betsabé.")), cont: (pscont("Psalmus L (51)"), pscont("Salmo 50 (51)")), foot: (psfoot, psfoot))

#spread((
  (vn(2, "Quam dilecta tabernacula tua, Domine virtutum!"), vn(2, "Senhor dos exércitos, quanto são para amar os teus tabernáculos!")),
  (vn(3, "Concupiscit, et deficit anima mea in atria Domini; cor meum et caro mea exsultaverunt in Deum vivum."), vn(3, "A minha alma deseja ardentemente estar na casa do Senhor, e quase que desfalece com o ardor deste desejo. O meu coração e a minha carne saltam de júbilo pelo amor que têm ao Deus vivo.")),
  (vn(4, "Etenim passer invenit sibi domum, et turtur nidum sibi, ubi ponat pullos suos: altaria tua, Domine virtutum, rex meus, et Deus meus."), vn(4, "Porque o pardal achou para si uma casa a que se retire, e a rola um ninho onde ponha os seus peladinhos. Assim desejo eu por lugar do meu retiro e do meu descanso os teus altares, ó Senhor dos exércitos, meu Rei e meu Deus.")),
  (vn(5, "Beati qui habitant in domo tua, Domine; in saecula saeculorum laudabunt te."), vn(5, "Bem-aventurados os que habitam na tua casa, Senhor: eles te louvarão por séculos de séculos.")),
  (vn(6, "Beatus vir cujus est auxilium abs te: ascensiones in corde suo disposuit,"), vn(6, "Bem-aventurado o homem que de ti espera o seu socorro, e que neste vale de lágrimas assentou no seu coração subir e elevar-se sempre,")),
  (vn(7, "in valle lacrimarum, in loco quem posuit."), vn(7, "até chegar ao lugar que o Senhor lhe constituiu.")),
  (vn(8, "Etenim benedictionem dabit legislator; ibunt de virtute in virtutem: videbitur Deus deorum in Sion."), vn(8, "Porque o divino Legislador lhe dará a sua bênção; e eles se adiantarão, passando de uma virtude a outra virtude, e enfim verão o Deus dos deuses em Sião.")),
  (vn(9, "Domine Deus virtutum, exaudi orationem meam; auribus percipe, Deus Jacob."), vn(9, "Senhor Deus dos exércitos, ouve a minha oração: põe atentas a ela as tuas orelhas, ó Deus de Jacó.")),
  (vn(10, "Protector noster, aspice, Deus, et respice in faciem christi tui."), vn(10, "Olha para nós, ó Deus, que és o nosso protetor; e lança os teus olhos sobre o rosto do teu ungido.")),
  (vn(11, "Quia melior est dies una in atriis tuis super millia; elegi abjectus esse in domo Dei mei magis quam habitare in tabernaculis peccatorum."), vn(11, "Porque um só dia que seja nos teus tabernáculos vale mais do que outros mil. Por isso eu escolhi ser antes o último na casa do meu Deus, do que habitar nos tabernáculos dos pecadores.")),
  (vn(12, "Quia misericordiam et veritatem diligit Deus: gratiam et gloriam dabit Dominus."), vn(12, "Porque Deus ama a misericórdia e a verdade: e o Senhor dará a graça e a glória;")),
  (vn(13, "Non privabit bonis eos qui ambulant in innocentia: Domine virtutum, beatus homo qui sperat in te."), vn(13, "e não privará dos bens aqueles que caminham na inocência. Senhor Deus dos exércitos, bem-aventurado o homem que espera em ti.")),
), toc: ((2, [83 (84) #h(0.4em) _Quam dilecta tabernacula tua_]),), head: (pshead("Psalmus LXXXIII (84)", "In finem, pro torcularibus filiis Core. Psalmus."), pshead("Salmo 83 (84)", "Para o fim, pelos lagares. Salmo aos filhos de Coré.")), cont: (pscont("Psalmus LXXXIII (84)"), pscont("Salmo 83 (84)")), foot: (psfoot, psfoot))

#spread((
  (vn(1, "Qui habitat in adjutorio Altissimi, in protectione Dei caeli commorabitur."), vn(1, "Aquele que permanece debaixo da assistência do Altíssimo descansará seguro debaixo da proteção do Deus do céu.")),
  (vn(2, "Dicet Domino: Susceptor meus es tu, et refugium meum; Deus meus, sperabo in eum."), vn(2, "Ele dirá ao Senhor: Tu és o meu defensor e o meu refúgio: ele é o meu Deus, e eu esperarei nele.")),
  (vn(3, "Quoniam ipse liberavit me de laqueo venantium, et a verbo aspero."), vn(3, "Porque ele mesmo me livrará do laço dos caçadores e da palavra áspera.")),
  (vn(4, "Scapulis suis obumbrabit tibi, et sub pennis ejus sperabis."), vn(4, "Ele te meterá como à sombra debaixo das suas espáduas, e tu esperarás estando coberto das suas asas.")),
  (vn(5, "Scuto circumdabit te veritas ejus: non timebis a timore nocturno;"), vn(5, "A sua verdade te cercará como um escudo: tu não temerás nada que suceda de noite;")),
  (vn(6, "a sagitta volante in die, a negotio perambulante in tenebris, ab incursu, et daemonio meridiano."), vn(6, "nem da seta que voa de dia; nem dos males que se preparam nas trevas; nem os ataques do demônio do meio-dia.")),
  (vn(7, "Cadent a latere tuo mille, et decem millia a dextris tuis; ad te autem non appropinquabit."), vn(7, "Cairão ao teu lado mil, e à tua direita dez mil; mas a morte não se aproximará a ti.")),
  (vn(8, "Verumtamen oculis tuis considerabis, et retributionem peccatorum videbis."), vn(8, "Antes tu contemplarás, e verás com os teus olhos a retribuição que levam os pecadores.")),
  (vn(9, "Quoniam tu es, Domine, spes mea; Altissimum posuisti refugium tuum."), vn(9, "Porque tu disseste: Senhor, tu és a minha esperança; e porque escolheste por teu refúgio ao Altíssimo.")),
  (vn(10, "Non accedet ad te malum, et flagellum non appropinquabit tabernaculo tuo."), vn(10, "O mal não chegará a ti, e o flagelo não se aproximará à tua tenda.")),
  (vn(11, "Quoniam angelis suis mandavit de te, ut custodiant te in omnibus viis tuis."), vn(11, "Porque ele mandou aos seus anjos que te guardassem em todos os teus caminhos.")),
  (vn(12, "In manibus portabunt te, ne forte offendas ad lapidem pedem tuum."), vn(12, "Eles te tomarão nas suas mãos, para que não suceda magoares o teu pé, dando nalguma pedra.")),
  (vn(13, "Super aspidem et basiliscum ambulabis, et conculcabis leonem et draconem."), vn(13, "Tu andarás por cima do áspide e do basilisco, e pisarás o leão e o dragão.")),
  (vn(14, "Quoniam in me speravit, liberabo eum; protegam eum, quoniam cognovit nomen meum."), vn(14, "Porque ele esperou em mim, eu o livrarei; eu serei o seu protetor, porque ele conheceu o meu nome.")),
  (vn(15, "Clamabit ad me, et ego exaudiam eum; cum ipso sum in tribulatione: eripiam eum, et glorificabo eum."), vn(15, "Ele clamará a mim, e eu o ouvirei; eu estou com ele no tempo da tribulação; eu o livrarei, e o cobrirei de glória.")),
  (vn(16, "Longitudine dierum replebo eum, et ostendam illi salutare meum."), vn(16, "Eu lhe darei uma vida dilatada; e eu lhe farei ver a salvação que lhe tenho destinada.")),
), toc: ((2, [90 (91) #h(0.4em) _Qui habitat in adjutorio Altissimi_]),), head: (pshead("Psalmus XC (91)", "Laus cantici David."), pshead("Salmo 90 (91)", "Louvor de cântico de David.")), cont: (pscont("Psalmus XC (91)"), pscont("Salmo 90 (91)")), foot: (psfoot, psfoot))

#spread((
  (vn(2, "Bonum est confiteri Domino, et psallere nomini tuo, Altissime:"), vn(2, "É bom louvar ao Senhor, e cantar em honra do teu nome, ó Altíssimo;")),
  (vn(3, "ad annuntiandum mane misericordiam tuam, et veritatem tuam per noctem,"), vn(3, "para anunciar de manhã a tua misericórdia, e à noite a tua verdade,")),
  (vn(4, "in decachordo, psalterio; cum cantico, in cithara."), vn(4, "ao som do saltério de dez cordas, com cântico ao som da cítara.")),
  (vn(5, "Quia delectasti me, Domine, in factura tua; et in operibus manuum tuarum exsultabo."), vn(5, "Porque tu, Senhor, me encheste de gosto ao ver as tuas criaturas; e eu mostrarei esta minha alegria, louvando as obras das tuas mãos.")),
  (vn(6, "Quam magnificata sunt opera tua, Domine! nimis profundae factae sunt cogitationes tuae."), vn(6, "Que grandiosas são, Senhor, as tuas obras! Que profundos os teus pensamentos!")),
  (vn(7, "Vir insipiens non cognoscet, et stultus non intelliget haec."), vn(7, "O homem insensato não as poderá conhecer, e o louco não terá delas inteligência alguma.")),
  (vn(8, "Cum exorti fuerint peccatores sicut foenum, et apparuerint omnes qui operantur iniquitatem, ut intereant in saeculum saeculi:"), vn(8, "Quando os pecadores tiverem nascido como a erva, e quando todos os que obram a iniquidade tiverem aparecido, eles perecerão para todos os séculos;")),
  (vn(9, "tu autem Altissimus in aeternum, Domine."), vn(9, "mas tu, Senhor, eternamente és o Altíssimo.")),
  (vn(10, "Quoniam ecce inimici tui, Domine, quoniam ecce inimici tui peribunt; et dispergentur omnes qui operantur iniquitatem."), vn(10, "Porque eis aí, Senhor, que os teus inimigos perecerão; e todos os que obram a iniquidade serão dissipados.")),
  (vn(11, "Et exaltabitur sicut unicornis cornu meum, et senectus mea in misericordia uberi."), vn(11, "E a minha força se exaltará como a ponta do unicórnio; e a minha velhice se remoçará pela tua abundante misericórdia.")),
  (vn(12, "Et despexit oculus meus inimicos meos, et in insurgentibus in me malignantibus audiet auris mea."), vn(12, "E o meu olho olhou com desprezo para os meus inimigos; e a minha orelha ouvirá falar do castigo dos maus que se levantam contra mim.")),
  (vn(13, "Justus ut palma florebit; sicut cedrus Libani multiplicabitur."), vn(13, "O justo florescerá como a palmeira, e se multiplicará como o cedro do Líbano.")),
  (vn(14, "Plantati in domo Domini, in atriis domus Dei nostri florebunt."), vn(14, "Os que estão plantados na casa do Senhor florescerão à entrada da casa do nosso Deus.")),
  (vn(15, "Adhuc multiplicabuntur in senecta uberi, et bene patientes erunt:"), vn(15, "Eles se multiplicarão de novo numa velhice cumulada de bens; e serão cheios de vigor e de paciência,")),
  (vn(16, "ut annuntient quoniam rectus Dominus Deus noster, et non est iniquitas in eo."), vn(16, "para anunciarem que o Senhor nosso Deus é reto, e que nele não há injustiça.")),
), toc: ((2, [91 (92) #h(0.4em) _Bonum est confiteri Domino_]),), head: (pshead("Psalmus XCI (92)", "Psalmus cantici, in die sabbati."), pshead("Salmo 91 (92)", "Salmo de cântico para o dia de sábado.")), cont: (pscont("Psalmus XCI (92)"), pscont("Salmo 91 (92)")), foot: (psfoot, psfoot))

#spread((
  (vn(1, "Benedic, anima mea, Domino, et omnia quae intra me sunt nomini sancto ejus."), vn(1, "Alma minha, bendize ao Senhor; e tudo o que há dentro de mim bendiga ao seu santo nome.")),
  (vn(2, "Benedic, anima mea, Domino, et noli oblivisci omnes retributiones ejus."), vn(2, "Alma minha, bendize ao Senhor; e não te esqueças jamais de algum dos seus benefícios.")),
  (vn(3, "Qui propitiatur omnibus iniquitatibus tuis; qui sanat omnes infirmitates tuas:"), vn(3, "Pois que ele é o que te perdoa todas as tuas iniquidades, e o que sara todas as tuas enfermidades;")),
  (vn(4, "qui redimit de interitu vitam tuam; qui coronat te in misericordia et miserationibus:"), vn(4, "ele o que resgata a tua vida da morte, o que te cerca da sua misericórdia e das suas graças;")),
  (vn(5, "qui replet in bonis desiderium tuum; renovabitur ut aquilae juventus tua:"), vn(5, "ele o que satisfaz os teus desejos, enchendo-te dos seus bens; e o que renova a tua mocidade, como a da águia.")),
  (vn(6, "faciens misericordias Dominus, et judicium omnibus injuriam patientibus."), vn(6, "O Senhor faz sentir os efeitos da sua misericórdia, e faz justiça a todos os que padecem qualquer injúria.")),
  (vn(7, "Notas fecit vias suas Moysi; filiis Israel voluntates suas."), vn(7, "Ele deu a conhecer os seus caminhos a Moisés, e as suas vontades aos filhos de Israel.")),
  (vn(8, "Miserator et misericors Dominus: longanimis, et multum misericors."), vn(8, "O Senhor é misericordioso e cheio de ternura; é paciente, e todo cheio de misericórdia.")),
  (vn(9, "Non in perpetuum irascetur, neque in aeternum comminabitur."), vn(9, "Ele não há de estar sempre irado, nem há de usar eternamente de ameaças.")),
  (vn(10, "Non secundum peccata nostra fecit nobis, neque secundum iniquitates nostras retribuit nobis."), vn(10, "Ele não nos tratou como mereciam os nossos pecados, nem nos castigou segundo a grandeza das nossas iniquidades.")),
  (vn(11, "Quoniam secundum altitudinem caeli a terra, corroboravit misericordiam suam super timentes se;"), vn(11, "Porque quanto o céu está elevado acima da terra, tanto corroborou ele a sua misericórdia sobre os que o temem.")),
  (vn(12, "quantum distat ortus ab occidente, longe fecit a nobis iniquitates nostras."), vn(12, "E quanto o oriente dista do ocidente, tanto afastou ele longe de nós as nossas iniquidades.")),
  (vn(13, "Quomodo miseretur pater filiorum, misertus est Dominus timentibus se."), vn(13, "Como um pai se compadece ternamente de seus filhos, assim o Senhor é todo compassivo para os que o temem.")),
  (vn(14, "Quoniam ipse cognovit figmentum nostrum; recordatus est quoniam pulvis sumus."), vn(14, "Porque ele conhece a fragilidade da nossa origem, e ele se lembra que não somos senão pó.")),
  (vn(15, "Homo, sicut foenum dies ejus; tamquam flos agri, sic efflorebit:"), vn(15, "O dia do homem passa como a erva: o seu florescer é como o da flor do campo.")),
  (vn(16, "quoniam spiritus pertransibit in illo, et non subsistet, et non cognoscet amplius locum suum."), vn(16, "Assopra o vento, e ela se seca; e não ficou mais vestígio dela no mesmo lugar em que tinha nascido.")),
  (vn(17, "Misericordia autem Domini ab aeterno, et usque in aeternum super timentes eum. Et justitia illius in filios filiorum,"), vn(17, "Porém a misericórdia do Senhor é desde a eternidade, e ela durará eternamente sobre os que o temem. E a sua justiça sobre os filhos dos filhos,")),
  (vn(18, "his qui servant testamentum ejus, et memores sunt mandatorum ipsius ad faciendum ea."), vn(18, "sobre os que guardam o seu pacto, e que se lembram dos seus preceitos para os cumprirem.")),
  (vn(19, "Dominus in caelo paravit sedem suam, et regnum ipsius omnibus dominabitur."), vn(19, "O Senhor preparou no céu o seu trono, e todas as coisas serão sujeitas ao seu império.")),
  (vn(20, "Benedicite Domino, omnes angeli ejus: potentes virtute, facientes verbum illius, ad audiendam vocem sermonum ejus."), vn(20, "Bendizei ao Senhor, vós todos os que sois seus anjos; que tendes tanta força e tanto poder, que fazeis o que ele vos manda, para obedecerdes à voz dos seus preceitos.")),
  (vn(21, "Benedicite Domino, omnes virtutes ejus; ministri ejus, qui facitis voluntatem ejus."), vn(21, "Bendizei ao Senhor, vós todos os que compondes os seus exércitos; que sois os seus ministros; que executais as suas vontades.")),
  (vn(22, "Benedicite Domino, omnia opera ejus: in omni loco dominationis ejus, benedic, anima mea, Domino."), vn(22, "Bendizei ao Senhor, todas as que sois obras suas, em todo o lugar da sua dominação; e tu, alma minha, bendize também ao Senhor.")),
), toc: ((2, [102 (103) #h(0.4em) _Benedic, anima mea, Domino_]),), head: (pshead("Psalmus CII (103)", "Ipsi David."), pshead("Salmo 102 (103)", "Do mesmo David.")), cont: (pscont("Psalmus CII (103)"), pscont("Salmo 102 (103)")), foot: (psfoot, psfoot))

#spread((
  (vn(1, "Levavi oculos meos in montes, unde veniet auxilium mihi."), vn(1, "Eu levantei os meus olhos aos montes, donde me há de vir o socorro.")),
  (vn(2, "Auxilium meum a Domino, qui fecit caelum et terram."), vn(2, "O meu socorro não deve vir senão do Senhor, que fez o céu e a terra.")),
  (vn(3, "Non det in commotionem pedem tuum, neque dormitet qui custodit te."), vn(3, "Ele não permita que o teu pé seja abalado, nem que dormite o que te guarda.")),
  (vn(4, "Ecce non dormitabit neque dormiet qui custodit Israel."), vn(4, "Seguramente o que guarda a Israel não dormitará, nem dormirá.")),
  (vn(5, "Dominus custodit te; Dominus protectio tua super manum dexteram tuam."), vn(5, "O Senhor te guarda: o Senhor está à tua mão direita para te proteger.")),
  (vn(6, "Per diem sol non uret te, neque luna per noctem."), vn(6, "Não te queimará de dia o sol, nem de noite a lua.")),
  (vn(7, "Dominus custodit te ab omni malo; custodiat animam tuam Dominus."), vn(7, "O Senhor te guarda de todo o mal: o Senhor guarde a tua alma.")),
  (vn(8, "Dominus custodiat introitum tuum et exitum tuum, ex hoc nunc et usque in saeculum."), vn(8, "O Senhor proteja a tua entrada e a tua saída, desde agora e para sempre.")),
), toc: ((2, [120 (121) #h(0.4em) _Levavi oculos meos in montes_]),), head: (pshead("Psalmus CXX (121)", "Canticum graduum."), pshead("Salmo 120 (121)", "Cântico dos degraus.")), cont: (pscont("Psalmus CXX (121)"), pscont("Salmo 120 (121)")), foot: (psfoot, psfoot))

#spread((
  (vn(1, "De profundis clamavi ad te, Domine;"), vn(1, "Eu, do profundo abismo em que me achava, clamei a ti, Senhor:")),
  (vn(2, "Domine, exaudi vocem meam. Fiant aures tuae intendentes in vocem deprecationis meae."), vn(2, "Ouve, Senhor, a minha voz. As tuas orelhas se ponham atentas à voz da minha súplica.")),
  (vn(3, "Si iniquitates observaveris, Domine, Domine, quis sustinebit?"), vn(3, "Se tu observares, Senhor, as nossas iniquidades, quem poderá subsistir, Senhor?")),
  (vn(4, "Quia apud te propitiatio est; et propter legem tuam sustinui te, Domine. Sustinuit anima mea in verbo ejus:"), vn(4, "Mas tu és cheio de misericórdia; e eu esperei em ti, Senhor, por causa da tua lei. A minha alma esperou na palavra do Senhor;")),
  (vn(5, "speravit anima mea in Domino."), vn(5, "a minha alma esperou no Senhor.")),
  (vn(6, "A custodia matutina usque ad noctem, speret Israel in Domino."), vn(6, "Israel espere no Senhor desde a guarda da manhã até a noite.")),
  (vn(7, "Quia apud Dominum misericordia, et copiosa apud eum redemptio."), vn(7, "Porque o Senhor é cheio de misericórdia, e nele se acha uma redenção copiosa.")),
  (vn(8, "Et ipse redimet Israel ex omnibus iniquitatibus ejus."), vn(8, "E ele mesmo resgatará a Israel de todas as suas iniquidades.")),
), toc: ((2, [129 (130) #h(0.4em) _De profundis_]),), head: (pshead("Psalmus CXXIX (130)", "Canticum graduum."), pshead("Salmo 129 (130)", "Cântico dos degraus.")), cont: (pscont("Psalmus CXXIX (130)"), pscont("Salmo 129 (130)")), foot: (psfoot, psfoot))

#spread((
  (vn(1, "Laudate Dominum in sanctis ejus; laudate eum in firmamento virtutis ejus."), vn(1, "Louvai o Senhor residente no seu santuário; louvai-o assentado no trono incontrastável do seu poder.")),
  (vn(2, "Laudate eum in virtutibus ejus; laudate eum secundum multitudinem magnitudinis ejus."), vn(2, "Louvai-o nos efeitos da sua virtude; louvai-o na sua grandeza, que é infinita.")),
  (vn(3, "Laudate eum in sono tubae; laudate eum in psalterio et cithara."), vn(3, "Louvai-o ao som da trombeta; louvai-o com o saltério e com a cítara.")),
  (vn(4, "Laudate eum in tympano et choro; laudate eum in chordis et organo."), vn(4, "Louvai-o com o tambor e com a flauta; louvai-o ao toque da viola e do órgão.")),
  (vn(5, "Laudate eum in cymbalis benesonantibus; laudate eum in cymbalis jubilationis."), vn(5, "Louvai-o com os timbales de um som retumbante; louvai-o com os timbales de um som alegre.")),
  (vn(6, "Omnis spiritus laudet Dominum! Alleluja."), vn(6, "Tudo o que tem fôlego louve ao Senhor. Aleluia.")),
), toc: ((2, [150 #h(0.4em) _Laudate Dominum in sanctis ejus_]),), head: (pshead("Psalmus CL", "Alleluja."), pshead("Salmo 150", "Aleluia.")), cont: (pscont("Psalmus CL"), pscont("Salmo 150")), foot: (psfoot, psfoot))

#spread((
  (vn(46, "Et ait Maria: Magnificat anima mea Dominum:"), vn(46, "Então disse Maria: A minha alma engrandece ao Senhor,")),
  (vn(47, "et exsultavit spiritus meus in Deo salutari meo."), vn(47, "e o meu espírito se alegrou por extremo em Deus, meu Salvador.")),
  (vn(48, "Quia respexit humilitatem ancillae suae: ecce enim ex hoc beatam me dicent omnes generationes,"), vn(48, "Por ele ter posto os olhos na baixeza de sua escrava; porque eis aí, de hoje em diante, me chamarão bem-aventurada todas as gerações.")),
  (vn(49, "quia fecit mihi magna qui potens est: et sanctum nomen ejus,"), vn(49, "Porque me fez grandes coisas o que é Poderoso; e santo o seu nome.")),
  (vn(50, "et misericordia ejus a progenie in progenies timentibus eum."), vn(50, "E a sua misericórdia se estende de geração a geração sobre os que o temem.")),
  (vn(51, "Fecit potentiam in brachio suo: dispersit superbos mente cordis sui."), vn(51, "Ele manifestou o poder do seu braço; dissipou os que no fundo do seu coração formavam altivos pensamentos.")),
  (vn(52, "Deposuit potentes de sede, et exaltavit humiles."), vn(52, "Depôs do trono os poderosos, e elevou os humildes.")),
  (vn(53, "Esurientes implevit bonis: et divites dimisit inanes."), vn(53, "Encheu de bens os que tinham fome, e despediu vazios os que eram ricos.")),
  (vn(54, "Suscepit Israel puerum suum, recordatus misericordiae suae:"), vn(54, "Tomou debaixo da sua proteção a Israel, seu servo, lembrado da sua misericórdia,")),
  (vn(55, "sicut locutus est ad patres nostros, Abraham et semini ejus in saecula."), vn(55, "assim como o tinha prometido a nossos pais, a Abraão e à sua posteridade para sempre.")),
), toc: ((2, [_Magnificat_]),), head: (pshead("Canticum Beatae Mariae Virginis", "Lc 1, 46–55"), pshead("Cântico de Nossa Senhora", "Lc 1, 46–55")), cont: (pscont("Magnificat"), pscont("Magnificat")), foot: (psfoot, psfoot))