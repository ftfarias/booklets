    [16], [#strong[refilar]], [Quanto tirar? Cada milímetro é para sempre],
    [20], [#strong[encaixar]], [A curva está uniforme? Marteladas não corrigem curva ruim],
    [24], [montar a capa], [O mordente bate com a pasta real?],
