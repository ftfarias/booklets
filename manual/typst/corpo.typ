#heading(level: 3)[Temperatura do foil, por material]

#emph[Pontos de partida das conversas de pesquisa. Quem manda é o teste no retalho.]

#tabela(3)(
  ([Material], [Faixa], [Observação]),
  (
    [Couro vegetal], [100–130 °C], [#strong[Comece em 110 °C]],
