    [#strong[Foil + clichê em prensa]], [O mesmo desenho em muitos exemplares; áreas grandes], [R\$ 1.500–5.000],
    [#strong[Folha de latão a quente]], [Treino do gesto; #strong[nunca] peça final], [R\$ 40],
